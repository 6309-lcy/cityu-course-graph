  "nodes": [
    {
      "id": "image_fn",
      "label": "Image as f(x,y)",
      "group": "formation",
      "lecture": "2",
      "detail": "Discrete 2D intensity (or vector) function sampled on a grid; foundation for all later ops."
    },
    {
      "id": "pixel_matrix",
      "label": "Matrix / pixels / channels",
      "group": "formation",
      "lecture": "2",
      "detail": "Rows\u00d7cols array; gray = 1 channel; RGB = 3. Pixel = sample at (i,j); dtype & range matter (0\u2013255 vs float)."
    },
    {
      "id": "display_coords",
      "label": "Display coordinates",
      "group": "formation",
      "lecture": "2",
      "detail": "Often origin top-left, +x right, +y down \u2014 not math-plane. Match OF/OpenCV conventions when coding."
    },
    {
      "id": "image_types",
      "label": "Binary / gray / color",
      "group": "formation",
      "lecture": "2",
      "detail": "Binary {0,1}; gray scalar; color multi-channel. Thresholding maps gray\u2192binary."
    },
    {
      "id": "noise",
      "label": "Additive noise",
      "group": "formation",
      "lecture": "2",
      "detail": "Observed = signal + noise (e.g. Gaussian). Motivates smoothing; salt-pepper \u2192 prefer median."
    },
    {
      "id": "histogram",
      "label": "Histogram",
      "group": "intensity",
      "lecture": "2",
      "detail": "Count of pixels per intensity bin. Shape shows contrast, exposure, multimodal scenes."
    },
    {
      "id": "hist_eq",
      "label": "Stretch / equalization",
      "group": "intensity",
      "lecture": "2",
      "detail": "Stretch remaps [min,max]\u2192full range; EQ flattens CDF for more uniform histogram / contrast."
    },
    {
      "id": "filt_vs_warp",
      "label": "Filtering vs warping",
      "group": "intensity",
      "lecture": "2",
      "detail": "Filtering changes intensities (same grid); warping moves pixels (geometry). Keep these separate."
    },
    {
      "id": "point_ops",
      "label": "Homogeneous point ops",
      "group": "intensity",
      "lecture": "2",
      "detail": "Output pixel depends only on same-location input (and global params): brightness, contrast, gamma, threshold."
    },
    {
      "id": "convolution",
      "label": "Convolution",
      "group": "filtering",
      "lecture": "2",
      "detail": "Neighborhood weighted sum with flipped kernel. Linear + shift-invariant filters = convolution."
    },
    {
      "id": "correlation",
      "label": "Correlation",
      "group": "filtering",
      "lecture": "2",
      "detail": "Same as convolution without kernel flip. Template matching often uses correlation."
    },
    {
      "id": "mean_box",
      "label": "Mean / box blur",
      "group": "filtering",
      "lecture": "2",
      "detail": "Uniform kernel; fast low-pass; boxes can ring. Separable \u2192 O(n) per axis."
    },
    {
      "id": "gaussian",
      "label": "Gaussian blur",
      "group": "filtering",
      "lecture": "2",
      "detail": "Isotropic low-pass; \u03c3 controls scale. Separable; preferred pre-blur before edges."
    },
    {
      "id": "median",
      "label": "Median filter",
      "group": "filtering",
      "lecture": "2",
      "detail": "Nonlinear; kills salt-pepper while preserving edges better than mean. Not a convolution."
    },
    {
      "id": "sharpen",
      "label": "Sharpen / unsharp",
      "group": "filtering",
      "lecture": "2",
      "detail": "Boost high frequencies: original + amount\u00d7(original \u2212 blur), or Laplacian-style kernels."
    },
    {
      "id": "edge_kernels",
      "label": "Edge kernels (Sobel\u2026)",
      "group": "filtering",
      "lecture": "2",
      "detail": "Derivative approximations (Sobel, Prewitt, Laplacian). Gradient magnitude \u2248 edge strength."
    },
    {
      "id": "boundary",
      "label": "Padding / borders",
      "group": "filtering",
      "lecture": "2",
      "detail": "How kernels treat edges: zero, replicate, reflect, wrap. Affects border artifacts."
    },
    {
      "id": "of_pipeline",
      "label": "OF / ofxCv load\u2013draw",
      "group": "practice",
      "lecture": "Tut 03",
      "detail": "Load ofImage, gray convert, draw; Mat ops via ofxCv \u2014 practice layer for Ch.2 ideas."
    },
    {
      "id": "quiz",
      "label": "Quiz (10%)",
      "group": "practice",
      "lecture": "Assess",
      "detail": "Catalogue continuous: Quiz 10% + assignments/project 50%; final exam 40% (\u226530% exam to pass). Exact date on Canvas."
    }
  ],
