  "nodes": [
    {
      "id": "prob_bayes",
      "label": "Prob / Bayes",
      "group": "math",
      "lecture": "1.1\u20131.2",
      "detail": "Probability, Bayes theorem, prior/likelihood/posterior. Foundation for generative classifiers and MLE."
    },
    {
      "id": "entropy_mi",
      "label": "Entropy / MI",
      "group": "math",
      "lecture": "1.x",
      "detail": "Shannon entropy, cross-entropy, mutual information. Links to decision trees, information gain, and probabilistic modeling."
    },
    {
      "id": "linalg_psd",
      "label": "LinAlg / PSD",
      "group": "math",
      "lecture": "2\u20135",
      "detail": "Vectors, matrices, eigenvalues, positive-semidefinite matrices. Normal equations, covariance, and kernel PSD conditions."
    },
    {
      "id": "convex_gd",
      "label": "Convex / GD / SGD",
      "group": "math",
      "lecture": "2\u20135",
      "detail": "Convexity, gradients, gradient descent and SGD. Training workhorse for logistic regression, ridge/lasso, and neural nets."
    },
    {
      "id": "duality_kkt",
      "label": "Duality / KKT",
      "group": "math",
      "lecture": "3\u20134",
      "detail": "Lagrangian dual, KKT conditions, complementary slackness. Core theory for hard/soft-margin SVM and kernel SVM."
    },
    {
      "id": "mle",
      "label": "MLE",
      "group": "math",
      "lecture": "1.2",
      "detail": "Maximum likelihood estimation: choose parameters that maximize data likelihood. Unifies NB, LDA, LogReg, OLS, and GMM fitting."
    },
    {
      "id": "bayes_knn",
      "label": "Bayes / KNN",
      "group": "classify_gen",
      "lecture": "1.2",
      "detail": "Bayes decision rule and k-nearest neighbors. Optimal Bayes classifier vs nonparametric local majority vote."
    },
    {
      "id": "nb",
      "label": "Naive Bayes",
      "group": "classify_gen",
      "lecture": "2.1",
      "detail": "Generative classifier with conditional independence of features given class. Fast, strong baseline; MLE for class-conditionals."
    },
    {
      "id": "lda",
      "label": "LDA",
      "group": "classify_gen",
      "lecture": "2.1",
      "detail": "Linear discriminant analysis: shared covariance Gaussian class-conditionals. Posterior odds yield a linear decision boundary."
    },
    {
      "id": "logreg",
      "label": "Logistic Regression",
      "group": "classify_disc",
      "lecture": "2.2",
      "detail": "Discriminative linear classifier; models P(y|x) with sigmoid. Trained by maximizing likelihood via GD/SGD (convex)."
    },
    {
      "id": "svm_linear",
      "label": "Linear SVM",
      "group": "margin",
      "lecture": "3.2",
      "detail": "Hard/soft-margin support vector machine. Maximizes geometric margin; dual with KKT; hinge loss vs logistic loss."
    },
    {
      "id": "kernel_svm",
      "label": "Kernel SVM",
      "group": "margin",
      "lecture": "4.2",
      "detail": "Kernel trick: implicit feature map via PSD kernel. Same dual as linear SVM in feature space (RBF, poly, etc.)."
    },
    {
      "id": "feature_map",
      "label": "Feature maps / kernels",
      "group": "margin",
      "lecture": "4.1\u20134.2",
      "detail": "\u03c6(x) and k(x,x')=\u27e8\u03c6(x),\u03c6(x')\u27e9. Mercer's theorem / PSD kernels enable nonlinear separators without explicit \u03c6."
    },
    {
      "id": "hinge_vs_logistic",
      "label": "Hinge vs logistic loss",
      "group": "margin",
      "lecture": "3.2 / 2.2",
      "detail": "Hinge (SVM) focuses on margin violations; logistic (LogReg) is smooth probabilistic. Same linear separator geometry, different objectives."
    },
    {
      "id": "ols",
      "label": "OLS",
      "group": "regression",
      "lecture": "5.1",
      "detail": "Ordinary least squares: minimize squared residual. Closed form via normal equations; under Gaussian noise equals MLE."
    },
    {
      "id": "ridge_lasso",
      "label": "Ridge / Lasso",
      "group": "regression",
      "lecture": "5.2",
      "detail": "L2 (ridge) and L1 (lasso) regularized linear regression. Bias\u2013variance tradeoff; lasso induces sparsity; convex optimization."
    },
    {
      "id": "ransac",
      "label": "RANSAC",
      "group": "regression",
      "lecture": "6.1",
      "detail": "Robust fitting by random sampling of inliers. Handles outliers that break OLS; used for nonlinear / geometric models too."
    },
    {
      "id": "nonlinear_reg",
      "label": "Nonlinear regression",
      "group": "regression",
      "lecture": "6.1",
      "detail": "Polynomial/basis expansions and nonlinear models. Connects to feature maps and kernel methods for flexible curves."
    },
    {
      "id": "clustering",
      "label": "Clustering / k-means",
      "group": "unsup",
      "lecture": "6.2",
      "detail": "Unsupervised grouping; k-means minimizes within-cluster SSE via alternating assignment and centroid updates."
    },
    {
      "id": "gmm",
      "label": "GMM / EM",
      "group": "unsup",
      "lecture": "6.2",
      "detail": "Gaussian mixture models fit via EM. Soft clusters; class-conditionals of LDA/QDA are a supervised cousin."
    },
    {
      "id": "ari",
      "label": "Adjusted Rand Index",
      "group": "unsup",
      "lecture": "6.2",
      "detail": "Cluster validity vs a ground-truth partition, chance-corrected. Used to score clustering quality when labels exist for eval."
    },
    {
      "id": "ha1",
      "label": "HA1",
      "group": "practice",
      "lecture": "HA1",
      "detail": "Homework 1: early classifiers and math\u2014Bayes/KNN, NB/LDA, LogReg basics, probability and MLE practice."
    },
    {
      "id": "ha2",
      "label": "HA2 (due Oct 20)",
      "group": "practice",
      "lecture": "HA2",
      "detail": "Homework 2 due Oct 20: convex/GD practice (Ex2), SVM dual and KKT (Ex3\u2013Ex5), margin/kernel ideas."
    },
    {
      "id": "tutorials",
      "label": "Tutorials",
      "group": "practice",
      "lecture": "TUT",
      "detail": "Tutorial sessions reinforcing lecture math and coding demos across classification, regression, and unsupervised topics."
    },
    {
      "id": "final_exam",
      "label": "Final exam",
      "group": "practice",
      "lecture": "Exam",
      "detail": "Cumulative assessment covering math foundations, generative/discriminative classifiers, SVM/kernels, regression, clustering."
    },
    {
      "id": "gaussian_class",
      "label": "Gaussian class-conditionals",
      "group": "classify_gen",
      "lecture": "2.1",
      "detail": "p(x|y) as multivariate Gaussians. Shared \u03a3 \u2192 LDA (linear); class-wise \u03a3 \u2192 QDA (quadratic). Shared with GMM components."
    },
    {
      "id": "linear_separator",
      "label": "Linear separators",
      "group": "classify_disc",
      "lecture": "2\u20133",
      "detail": "Hyperplane decision boundaries shared by LDA (posterior), LogReg, and linear SVM\u2014different estimation criteria."
    },
    {
      "id": "normal_eq",
      "label": "Normal equations",
      "group": "regression",
      "lecture": "5.1",
      "detail": "X\u1d40X \u03b2 = X\u1d40y closed form for OLS. Requires LinAlg (invertibility / PSD of Gram matrix); ridge adds \u03bbI."
    },
    {
      "id": "drop_labels",
      "label": "Supervised \u2192 unsupervised",
      "group": "unsup",
      "lecture": "6.2",
      "detail": "Drop class labels and the same feature space becomes a clustering problem; GMM softens hard k-means partitions."
    },
    {
      "id": "ha2_ex2",
      "label": "HA2 Ex2 (GD)",
      "group": "practice",
      "lecture": "HA2 Ex2",
      "detail": "Homework exercise on convexity and gradient/SGD steps\u2014applies Convex/GD ideas to concrete training problems."
    },
    {
      "id": "ha2_ex345",
      "label": "HA2 Ex3\u20135 (SVM dual)",
      "group": "practice",
      "lecture": "HA2 Ex3\u20135",
      "detail": "Dual formulation, KKT, and support vectors\u2014tight link from Duality/KKT math to linear/kernel SVM."
    }
  ],
