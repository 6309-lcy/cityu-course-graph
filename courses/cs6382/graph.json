  "nodes": [
    {
      "id": "algo_def",
      "label": "Algorithm definition",
      "group": "foundations",
      "lecture": "CS4335 L1",
      "detail": "Input, output, definiteness, finiteness. Design pipeline: define \u2192 design \u2192 prove \u2192 analyze (Big-O)."
    },
    {
      "id": "graph_basics",
      "label": "Graph terms / degree",
      "group": "foundations",
      "lecture": "CS4335 L1",
      "detail": "G=(V,E); degree; path/circuit; connected; adj list O(V+E) vs matrix O(V\u00b2)."
    },
    {
      "id": "euler",
      "label": "Euler circuit theorem",
      "group": "foundations",
      "lecture": "CS4335 L1",
      "detail": "Connected + all even degrees \u21d4 Euler circuit. Circuit-merge algorithm. vs Hamiltonian (NP-complete)."
    },
    {
      "id": "greedy_principle",
      "label": "Greedy principle",
      "group": "greedy",
      "lecture": "CS4335 L2",
      "detail": "Locally best choice each step; hard part is proving global optimality."
    },
    {
      "id": "interval_sched",
      "label": "Interval scheduling",
      "group": "greedy",
      "lecture": "CS4335 L2",
      "detail": "Earliest finish time; O(n log n). Failed rules: earliest start, shortest, fewest conflicts."
    },
    {
      "id": "interval_part",
      "label": "Interval partitioning / depth",
      "group": "greedy",
      "lecture": "CS4335 L2",
      "detail": "Sort by start; open room only if needed. Depth = lower bound = greedy room count."
    },
    {
      "id": "knapsack_frac",
      "label": "Fractional knapsack",
      "group": "greedy",
      "lecture": "CS4335 L5",
      "detail": "Greedy by unit price v/w; fractions OK. 0-1 knapsack: greedy fails (counterexample)."
    },
    {
      "id": "min_lateness",
      "label": "Minimize max lateness (EDF)",
      "group": "greedy",
      "lecture": "CS4335 L5",
      "detail": "Earliest deadline first; no idle; adjacent inversion swap. Shortest / smallest slack fail."
    },
    {
      "id": "sjf_wait",
      "label": "Minimize waiting time (SJF)",
      "group": "greedy",
      "lecture": "CS4335 L5",
      "detail": "Shortest job first; adjacent inversion exchange on waiting-time sum."
    },
    {
      "id": "boat_rescue",
      "label": "Boat rescue",
      "group": "greedy",
      "lecture": "CS4335 L4",
      "detail": "Pair heaviest with lightest if \u2264W else alone; two-pointer; exchange + induction."
    },
    {
      "id": "mst",
      "label": "MST + cut property",
      "group": "graphs_paths",
      "lecture": "CS4335 L3",
      "detail": "Spanning tree min weight. Lightest edge across a cut is safe (exchange \u2113 for \u2113\u2032)."
    },
    {
      "id": "kruskal",
      "label": "Kruskal",
      "group": "graphs_paths",
      "lecture": "CS4335 L3",
      "detail": "Sort edges; add if joins two components (forest). O(E log E) + Union-Find."
    },
    {
      "id": "prim",
      "label": "Prim",
      "group": "graphs_paths",
      "lecture": "CS4335 L3",
      "detail": "Grow one tree; add lightest leaving edge. Heap O(E log V). Like Dijkstra but keys are edge weights."
    },
    {
      "id": "dijkstra",
      "label": "Dijkstra",
      "group": "graphs_paths",
      "lecture": "CS4335 L4",
      "detail": "Nonneg weights; EXTRACT-MIN + relax. Array O(V\u00b2) / heap O(E log V). Neg edges break it."
    },
    {
      "id": "relax",
      "label": "Relaxation",
      "group": "graphs_paths",
      "lecture": "CS4335 L4",
      "detail": "if d[v] > d[u]+w(u,v): update d and \u03c0. Optimal substructure of shortest paths."
    },
    {
      "id": "dc_principle",
      "label": "Divide\u2013conquer principle",
      "group": "divide_conquer",
      "lecture": "CS4335 L6",
      "detail": "Divide \u2192 recur \u2192 combine. Exam framework for designing D&C (e.g. midterm Q5)."
    },
    {
      "id": "mergesort",
      "label": "Merge sort",
      "group": "divide_conquer",
      "lecture": "CS4335 L6",
      "detail": "T(n)=2T(n/2)+n = O(n log n). Merge two sorted halves with two pointers."
    },
    {
      "id": "inversions",
      "label": "Counting inversions",
      "group": "divide_conquer",
      "lecture": "CS4335 L6",
      "detail": "Sort-and-Count; cross inversions when taking from B: count += |A|\u2212i. O(n log n)."
    },
    {
      "id": "iteration",
      "label": "Iteration method",
      "group": "divide_conquer",
      "lecture": "CS4335 L6",
      "detail": "Substitute \u2192 pattern after k steps \u2192 set n/2^k=1 \u2192 asymptotics. Midterm Q4(b\u2013d)."
    },
    {
      "id": "karatsuba",
      "label": "Karatsuba (fun / not tested)",
      "group": "divide_conquer",
      "lecture": "CS4335 L6",
      "detail": "3 multiplies of N/2 digits \u2192 O(N^log\u20823). Lecture marks not tested."
    },
    {
      "id": "exchange",
      "label": "Exchange argument",
      "group": "proofs",
      "lecture": "L2/L5",
      "detail": "Transform Opt into greedy without worsening cost (interval scheduling, EDF, SJF, knapsack, boat)."
    },
    {
      "id": "structural",
      "label": "Structural lower bound",
      "group": "proofs",
      "lecture": "L2",
      "detail": "All solutions \u2265 D (e.g. depth); greedy = D \u2192 optimal (interval partitioning)."
    },
    {
      "id": "induction_dijk",
      "label": "Induction on S (Dijkstra)",
      "group": "proofs",
      "lecture": "L4",
      "detail": "When v enters S, any path P \u2265 d[v] via first edge leaving S (needs w\u22650)."
    },
    {
      "id": "maxflow",
      "label": "Max-flow / cuts (CS6382)",
      "group": "cs6382",
      "lecture": "CS6382 Ch.4",
      "detail": "Complement to CS4335 graph paths; flow\u2013cut duality, randomized algorithms chapter."
    },
    {
      "id": "game_theory",
      "label": "Game theory basics (CS6382)",
      "group": "cs6382",
      "lecture": "CS6382 Ch.5",
      "detail": "Nash / defending games; nest under strategic/optimization complements after midterm spine."
    },
    {
      "id": "network_defend",
      "label": "Network defending games",
      "group": "cs6382",
      "lecture": "CS6382 5.3",
      "detail": "Attacker\u2013defender on networks; builds on Ch.5 basics."
    },
    {
      "id": "midterm_cs4335",
      "label": "CS4335 midterm (Week 8 Fri 3\u20135)",
      "group": "practice",
      "lecture": "assess",
      "detail": "Greedy + divide-and-conquer only; DP not tested. 2025 paper: interval, MST, Dijkstra, inversions/recurrences, D&C design, exchange greedy."
    }
  ],
